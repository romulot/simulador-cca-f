const D5: Curadoria[] = [
  { n: 1, correta: "C", resumo: "Quando fontes discordam genuinamente, a síntese deve preservar a incerteza no nível da fonte, distinguindo achados bem estabelecidos de afirmações contestadas, em vez de colapsar dados conflitantes numa única afirmação confiante.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S3 — Multi-Agent Research System", principio: "síntese deve preservar incerteza entre fontes, não colapsar conflito em afirmação única confiante", topicos: ["Proveniência e Síntese"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", D: "sinal-nao-confiavel" } },
  { n: 2, correta: "A", resumo: "Decisões que precisam continuar valendo ao longo de uma sessão longa devem ir para um objeto de estado estruturado, não depender do fluxo da conversa — sumarização, sliding window e retenção seletiva são as outras técnicas da mesma família.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "decisão que precisa continuar valendo vai para objeto de estado estruturado, não para o histórico de conversa", topicos: ["Contexto Longo"], arquetipos: { B: "probabilistico-vs-garantia", C: "montante-jusante", D: "over-engineering" } },
  { n: 3, correta: "B", resumo: "Roteamento para revisão humana deve se basear em score de confiança, características do documento e ambiguidade em nível de campo, não em amostragem aleatória — dia da semana e comprimento do documento são proxies fracos.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "roteamento para revisão humana usa sinais objetivos (confiança, características, ambiguidade), não amostragem aleatória", topicos: ["Validação e Retry"], arquetipos: { A: "feature-inexistente-verossimil", C: "over-engineering", D: "camada-alvo-errado" } },
  { n: 4, correta: "D", resumo: "Uma chave expirada é falha de acesso (`access_failure`), não \"nenhum resultado\" (`valid_empty`) — confundir os dois faz o coordenador concluir que um tema não tem cobertura quando na verdade ninguém conseguiu nem olhar.", bloom: "Analisar", dificuldade: "Médio", cenario: "S3 — Multi-Agent Research System", principio: "falha de acesso (chave expirada) e resultado vazio-válido são estados diferentes — confundi-los engana o coordenador sobre cobertura", topicos: ["Propagação de Erros"], arquetipos: { A: "camada-alvo-errado", B: "extremo-vs-meio", C: "camada-alvo-errado" } },
  { n: 5, correta: "B", resumo: "Isolamento de subagente, arquivos de scratchpad e leitura dirigida de arquivo sustentam exploração coerente de um código grande ao longo de sessões que excedem o limite de contexto — \"memorizar\" não é mecanismo, e trabalhar de memória sobre 500 mil linhas é alucinar.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "subagente isolado + scratchpad + leitura dirigida sustentam exploração de codebase além do limite de uma sessão", topicos: ["Contexto de Codebase", "Contexto Longo"], arquetipos: { A: "extremo-vs-meio", C: "feature-inexistente-verossimil", D: "over-engineering" } },
  { n: 6, correta: "A", resumo: "Formatos estruturados mantêm conteúdo e metadado de origem viajando juntos — a proveniência precisa viajar com a afirmação, não ao lado dela numa bibliografia solta ao final ou numa contagem de fontes.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S3 — Multi-Agent Research System", principio: "proveniência precisa viajar junto com cada afirmação (formato estruturado), não separada em bibliografia ou contagem", topicos: ["Proveniência e Síntese"], arquetipos: { B: "montante-jusante", C: "vazio-ausente", D: "probabilistico-vs-garantia" } },
  { n: 7, correta: "D", resumo: "Um pacote estruturado que o agente monta antes de escalar — contexto, ações tentadas, bloqueio — evita que o humano precise vasculhar o histórico; encerrar sem escalar abandona o caso, e repetir tools que já falharam é loop improdutivo.", bloom: "Aplicar", dificuldade: "Fácil", cenario: "S1 — Customer Support Resolution Agent", principio: "handoff estruturado (contexto + ações + bloqueio) antes de escalar, em vez de abandonar ou repetir o que já falhou", topicos: ["Enforcement de Workflow"], arquetipos: { A: "vazio-ausente", B: "camada-alvo-errado", C: "camada-alvo-errado" } },
  { n: 8, correta: "A", resumo: "Quando três leituras plausíveis de um pedido levam a trabalhos materialmente diferentes, perguntar antes é mais barato que desfazer depois — fazer as três multiplica trabalho e risco, e escolher em silêncio esconde a decisão de quem tinha autoridade para tomá-la.", bloom: "Avaliar", dificuldade: "Médio", cenario: "S3 — Multi-Agent Research System", principio: "ambiguidade genuína com interpretações materialmente diferentes pede pergunta antes de agir, não escolha silenciosa", topicos: ["Escalação de Ambiguidade"], arquetipos: { B: "over-engineering", C: "vazio-ausente", D: "probabilistico-vs-garantia" } },
  { n: 9, correta: "B", resumo: "O filtro do que o agente realmente precisa deve acontecer na própria tool, antes de o dado entrar no contexto — os tokens já entraram depois disso, \"focar\" não os remove, e janela maior só paga mais pelo mesmo ruído.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "filtrar a saída da tool antes de entrar no contexto, não depois", topicos: ["Contexto Longo"], arquetipos: { A: "montante-jusante", C: "camada-alvo-errado", D: "extremo-vs-meio" } },
  { n: 10, correta: "D", resumo: "Dados numéricos e de preço podem se perder ao longo de várias passadas de sumarização — a solução é extrair os dados-chave e reinjetá-los diretamente no próximo prompt, já que o processo de condensação em cadeia é o que os apaga, não um truncamento no fim.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "extrair e reinjetar dados numéricos evita a perda ao longo de sumarizações sucessivas", topicos: ["Contexto Longo"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", C: "camada-alvo-errado" } },
  { n: 11, correta: "A", resumo: "Quando a evidência entre fontes é genuinamente mista, o comportamento pedido é distinguir o que está consolidado do que é contestado — contar fontes não é peso de evidência, e média de valores conflitantes produz um número que nenhuma fonte afirma.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S3 — Multi-Agent Research System", principio: "evidência mista pede distinguir consolidado de contestado, não média nem contagem de fontes", topicos: ["Proveniência e Síntese"], arquetipos: { B: "camada-alvo-errado", C: "over-engineering", D: "sinal-nao-confiavel" } },
  { n: 12, correta: "C", resumo: "Cada requisição à API é nova e sem estado — o histórico inteiro precisa ser reenviado a cada vez, o que faz o contexto crescer; a solução recomendada é resumir parte ou todo o histórico da conversa.", bloom: "Lembrar", dificuldade: "Fácil", cenario: "S4 — Developer Productivity", principio: "API é stateless — histórico cresce a cada requisição; a solução é resumir a conversa", topicos: ["Contexto Longo"], arquetipos: { A: "feature-inexistente-verossimil", B: "feature-inexistente-verossimil", D: "extremo-vs-meio" } },
  { n: 13, correta: "C", resumo: "Diante de uma falha parcial num lote, o certo é preservar os quatro sucessos e declarar explicitamente a lacuna do que falhou — um relatório incompleto mas declarado é melhor que um que esconde a cobertura faltante.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S3 — Multi-Agent Research System", principio: "falha parcial preserva sucessos e declara a lacuna explicitamente, nunca a esconde", topicos: ["Propagação de Erros"], arquetipos: { A: "over-engineering", B: "feature-inexistente-verossimil", D: "vazio-ausente" } },
  { n: 14, correta: "A", resumo: "Ao retomar uma sessão é preciso orientar o modelo explicitamente a se atualizar ou começar com um novo resumo estruturado — ele não sabe quanto tempo passou nem o que mudou; perguntar ao próprio agente o que mudou fora da sessão é perguntar a quem não tem como saber.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "retomar sessão exige orientar explicitamente a atualização — o modelo não sabe o que mudou sozinho", topicos: ["Resume e Fork de Sessão"], arquetipos: { B: "sinal-nao-confiavel", C: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 15, correta: "C", resumo: "Combinar o auto-relato de confiança com sinais objetivos — nulos em campos obrigatórios, layout desconhecido, validação cruzada reprovada — é a forma mais defensável de decidir revisão humana; confiança sozinha é o elo fraco, e mexer só no limiar não resolve isso.", bloom: "Analisar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "revisão humana deve combinar confiança auto-relatada com sinais objetivos, não confiar só num limiar de confiança", topicos: ["Validação e Retry"], arquetipos: { A: "extremo-vs-meio", B: "extremo-vs-meio", D: "camada-alvo-errado" } },
  { n: 16, correta: "B", resumo: "Um objeto de estado estruturado, reinjetado a cada prompt, mantém uma restrição em vigor sem depender de sobreviver à sumarização do histórico — repetir uma vez no meio da conversa não garante isso, e \"lembre-se\" é instrução, não mecanismo.", bloom: "Analisar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "restrição que precisa valer sempre vive num objeto de estado reinjetado, não depende de sobreviver à compactação do histórico", topicos: ["Contexto Longo"], arquetipos: { A: "extremo-vs-meio", C: "camada-alvo-errado", D: "probabilistico-vs-garantia" } },
  { n: 17, correta: "D", resumo: "Se toda afirmação carrega sua fonte, uma afirmação sem fonte fica visível e pode ser tratada de forma diferente na síntese — é a proveniência funcionando como controle contra alucinação, não rodar de novo ou usar mais subagentes.", bloom: "Analisar", dificuldade: "Difícil", cenario: "S3 — Multi-Agent Research System", principio: "exigir fonte em cada afirmação torna visível a afirmação sem fonte, funcionando como controle contra invenção", topicos: ["Proveniência e Síntese"], arquetipos: { A: "sinal-nao-confiavel", B: "extremo-vs-meio", C: "probabilistico-vs-garantia" } },
  { n: 18, correta: "D", resumo: "Retenção seletiva — compactar ou remover a parte já resolvida da conversa, mantendo o que ainda opera — é a técnica certa; fork mantém os dois ramos vivos sem reduzir contexto, e limpar tudo perderia mensagens ainda relevantes.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "retenção seletiva remove/compacta o que já foi resolvido, preservando o que ainda está em uso", topicos: ["Contexto Longo"], arquetipos: { A: "camada-alvo-errado", B: "sinal-nao-confiavel", C: "extremo-vs-meio" } },
  { n: 19, correta: "C", resumo: "Um erro de limite de taxa é transitório — marcar como `retryable: true` e esperar para repetir é a ação correta; escalar para humano ou marcar como \"sem achados\" desperdiçam ou escondem uma falha que se resolve sozinha.", bloom: "Aplicar", dificuldade: "Fácil", cenario: "S3 — Multi-Agent Research System", principio: "rate limit é transitório e retentável — não deve virar escalonamento nem lacuna silenciosa", topicos: ["Erros Estruturados", "Propagação de Erros"], arquetipos: { A: "over-engineering", B: "vazio-ausente", D: "camada-alvo-errado" } },
  { n: 20, correta: "C", resumo: "Quando a resposta depende de informação que o agente não consegue obter, o comportamento correto é declarar a limitação e escalar ou perguntar — disclaimer genérico em toda resposta dilui o sinal, e responder com confiança sobre uma suposição é o modo de falha mais caro.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S1 — Customer Support Resolution Agent", principio: "informação inacessível exige declarar a limitação e escalar, não disclaimer genérico nem resposta confiante sobre suposição", topicos: ["Escalação de Ambiguidade"], arquetipos: { A: "extremo-vs-meio", B: "vazio-ausente", D: "sinal-nao-confiavel" } },
  { n: 21, correta: "D", resumo: "Diante de muito conteúdo de uma vez, o modelo tende a usar bem o início e o fim e ignorar o meio — a solução é verificar e processar em seções; pedir atenção ao meio ou inverter a ordem não mudam a distribuição de atenção.", bloom: "Analisar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "\"lost in the middle\" se resolve processando em seções, não pedindo atenção nem reordenando", topicos: ["Contexto Longo"], arquetipos: { A: "probabilistico-vs-garantia", B: "camada-alvo-errado", C: "extremo-vs-meio" } },
  { n: 22, correta: "D", resumo: "Um campo de status/força por afirmação, junto com a fonte, permite ao leitor separar o que é sólido do que é provisório — um score único para o relatório inteiro ou tom cauteloso genérico não localizam qual afirmação específica é frágil.", bloom: "Analisar", dificuldade: "Difícil", cenario: "S3 — Multi-Agent Research System", principio: "status/força por afirmação (não um score único do relatório) é o que permite distinguir sólido de provisório", topicos: ["Proveniência e Síntese"], arquetipos: { A: "vazio-ausente", B: "sinal-nao-confiavel", C: "camada-alvo-errado" } },
  { n: 23, correta: "C", resumo: "A auto-compactação usa a folga reservada da janela de contexto para resumir o histórico automaticamente; além disso o desenvolvedor tem `/compact` (resumir sob demanda) e `/clear` (zerar a conversa, preservando `CLAUDE.md` e AutoMemory).", bloom: "Lembrar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "auto-compactação usa buffer reservado; `/compact` e `/clear` são os comandos manuais equivalentes", topicos: ["Contexto Longo", "Resume e Fork de Sessão"], arquetipos: { A: "feature-inexistente-verossimil", B: "vazio-ausente", D: "camada-alvo-errado" } },
  { n: 24, correta: "A", resumo: "Diante da falha de um documento no meio de um lote, o padrão é tentar de novo localmente, usar um fallback, e só escalar se as tentativas se esgotarem — reportando especificamente o que não deu certo, sem derrubar o lote inteiro nem pular em silêncio.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S3 — Multi-Agent Research System", principio: "falha isolada num lote pede retry/fallback/escalonamento e relato específico, não abortar tudo nem esconder", topicos: ["Propagação de Erros"], arquetipos: { B: "vazio-ausente", C: "feature-inexistente-verossimil", D: "extremo-vs-meio" } },
  { n: 25, correta: "C", resumo: "O schema de saída de um subagente deve ser desenhado no formato mais adequado para a síntese e o relatório a jusante — dados estruturados, prosa e metadados de citação, cada um onde serve; nem \"estruturado é sempre melhor\" nem \"prosa é sempre melhor\" se sustentam.", bloom: "Avaliar", dificuldade: "Difícil", cenario: "S3 — Multi-Agent Research System", principio: "schema de saída do subagente é desenhado conforme a necessidade da síntese a jusante, sem regra universal", topicos: ["Proveniência e Síntese"], arquetipos: { A: "camada-alvo-errado", B: "extremo-vs-meio", D: "extremo-vs-meio" } },
  { n: 26, correta: "B", resumo: "Quando o modelo lembra errado um detalhe que está longe no histórico, a técnica certa é a leitura dirigida no ponto de uso — conteúdo distante na conversa não é fonte confiável; recolar a cada mensagem multiplica custo, e \"lembre com mais cuidado\" não é mecanismo.", bloom: "Analisar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "leitura dirigida no ponto de uso corrige informação distante e não confiável no histórico", topicos: ["Contexto Longo"], arquetipos: { A: "camada-alvo-errado", C: "probabilistico-vs-garantia", D: "camada-alvo-errado" } },
  { n: 27, correta: "A", resumo: "Para os 20% de casos que já escalam, o que muda o tempo de atendimento deles é a qualidade do pacote de handoff — resumo mais longo sem estrutura ou mais tools reduzem quem escala, mas não ajudam quem já está escalando.", bloom: "Analisar", dificuldade: "Difícil", cenario: "S1 — Customer Support Resolution Agent", principio: "para casos já escalados, o que melhora o atendimento é o pacote de handoff estruturado, não reduzir a taxa de escalonamento", topicos: ["Enforcement de Workflow"], arquetipos: { B: "vazio-ausente", C: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 28, correta: "C", resumo: "Sem um identificador de fonte viajando com cada achado, a síntese não consegue perceber que duas \"confirmações\" na verdade vêm da mesma fonte contada duas vezes — deduplicar por similaridade de texto não detecta essa origem comum com redações diferentes.", bloom: "Analisar", dificuldade: "Difícil", cenario: "S3 — Multi-Agent Research System", principio: "identificador de fonte por achado é o que permite detectar corroboração duplicada da mesma origem", topicos: ["Proveniência e Síntese"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", D: "vazio-ausente" } },
  { n: 29, correta: "A", resumo: "Quando o custo de errar é alto, o comportamento certo é explicitar a incerteza e o que a resolveria, levando a decisão ao humano — confiança sem base ou um score numérico auto-estimado transferem a decisão sem transferir informação confiável.", bloom: "Avaliar", dificuldade: "Médio", cenario: "S1 — Customer Support Resolution Agent", principio: "custo alto de erro é o gatilho para declarar incerteza e escalar ao humano, não decidir sozinho", topicos: ["Escalação de Ambiguidade"], arquetipos: { B: "sinal-nao-confiavel", C: "extremo-vs-meio", D: "sinal-nao-confiavel" } },
  { n: 30, correta: "C", resumo: "O estado do pipeline deve viver fora da conversa e ser consultado como fonte de verdade — o histórico é volátil por design; buffer maior só adia o estouro, e desligar compactação não resolve a perda de informação.", bloom: "Analisar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "estado crítico deve viver fora da conversa (fonte de verdade externa), não dentro do histórico volátil", topicos: ["Contexto Longo", "Resume e Fork de Sessão"], arquetipos: { A: "camada-alvo-errado", B: "probabilistico-vs-garantia", D: "camada-alvo-errado" } },
  { n: 31, correta: "C", resumo: "Para trocar de assunto sem misturar contexto da tarefa anterior, `/clear` zera a conversa mas não limpa `CLAUDE.md` nem AutoMemory — `/compact` mantém o fio (contaminação continua, só resumida), e `/resume` carregaria outra sessão.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "`/clear` zera conversa sem afetar `CLAUDE.md`/AutoMemory — certo para trocar de tarefa sem misturar contexto", topicos: ["Resume e Fork de Sessão"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 32, correta: "A", resumo: "\"Prefira o dado mais específico\" é uma regra de resolução de conflito declarada e verificável — a síntese deixa de resolver divergência por acaso; não é ranking de confiabilidade de agentes nem verificação de acurácia de fonte.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S3 — Multi-Agent Research System", principio: "regra explícita de resolução de conflito (ex.: preferir o dado mais específico) evita resolução arbitrária de divergência", topicos: ["Coordenador e Subagentes", "Proveniência e Síntese"], arquetipos: { B: "camada-alvo-errado", C: "camada-alvo-errado", D: "vazio-ausente" } },
  { n: 33, correta: "D", resumo: "Um campo obrigatório que voltou nulo é uma propriedade objetiva e verificável da saída — diferente de uma estimativa que o próprio modelo fez sobre si mesmo; correlação com comprimento ou custo de cálculo não são o critério de qualidade do sinal.", bloom: "Analisar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "campo obrigatório nulo é sinal objetivo e verificável, diferente de autoavaliação do modelo", topicos: ["Validação e Retry"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", C: "camada-alvo-errado" } },
  { n: 34, correta: "B", resumo: "O contexto do coordenador é finito — o subagente existe justamente para absorver o volume de exploração e devolver o essencial com proveniência; \"nada se perde\" ignora que o contexto estoura, e compactar só depois de encher é remediar um desenho evitável.", bloom: "Analisar", dificuldade: "Médio", cenario: "S3 — Multi-Agent Research System", principio: "subagente absorve volume e devolve o essencial com proveniência, evitando estourar o contexto finito do coordenador", topicos: ["Spawn de Subagentes", "Proveniência e Síntese"], arquetipos: { A: "vazio-ausente", C: "vazio-ausente", D: "montante-jusante" } },
  { n: 35, correta: "B", resumo: "Antes de decidir como agir, ver a quebra de consumo por categoria em `/context` evita compactar o histórico quando o peso real está em resultados de tool (que deveriam ser filtrados na origem) — modelo maior adia sem entender a causa.", bloom: "Analisar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "verificar o consumo de contexto por categoria antes de decidir a ação (compactar vs. filtrar tool), não agir às cegas", topicos: ["Contexto Longo"], arquetipos: { A: "camada-alvo-errado", C: "sinal-nao-confiavel", D: "extremo-vs-meio" } },
  { n: 36, correta: "D", resumo: "O agente transformou \"não consegui olhar\" em \"olhei e não há nada\" — é o caso canônico de tratar ausência de evidência como evidência de ausência; retirar acesso ou tentar de novo com a mesma permissão quebrada não corrige a ambiguidade do retorno.", bloom: "Analisar", dificuldade: "Difícil", cenario: "S3 — Multi-Agent Research System", principio: "\"não consegui verificar\" e \"verifiquei e não há\" são estados diferentes — confundi-los trata ausência de evidência como evidência de ausência", topicos: ["Propagação de Erros"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", C: "camada-alvo-errado" } },
  { n: 37, correta: "B", resumo: "Isolamento em subagente — a exploração acontece num contexto separado e só a conclusão estruturada volta para a sessão principal — evita inundar o contexto principal; explorar na sessão principal já paga o custo antes de qualquer compactação.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "isolar exploração em subagente evita inundar a sessão principal; só a conclusão estruturada retorna", topicos: ["Contexto de Codebase", "Spawn de Subagentes"], arquetipos: { A: "montante-jusante", C: "camada-alvo-errado", D: "over-engineering" } },
  { n: 38, correta: "B", resumo: "O metadado de fonte precisa carregar o tipo de fonte (ex.: marketing do próprio fornecedor vs. fonte independente), não só a existência de uma fonte — é o que permite ao leitor pesar a credibilidade de cada uma; timestamp e score de confiança não dizem isso.", bloom: "Analisar", dificuldade: "Médio", cenario: "S3 — Multi-Agent Research System", principio: "metadado de fonte precisa incluir o TIPO de fonte, para o leitor pesar credibilidade, não só confirmar existência", topicos: ["Proveniência e Síntese"], arquetipos: { A: "camada-alvo-errado", C: "sinal-nao-confiavel", D: "vazio-ausente" } },
  { n: 39, correta: "B", resumo: "Uma ação irreversível sobre dados de produção exige autorização humana — a confiança do próprio agente não é autorização nem sinal confiável, especialmente porque o modelo pode estar confiante justamente quando erra.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "ação irreversível em produção exige autorização humana, nunca confiança auto-relatada do agente", topicos: ["Enforcement de Workflow"], arquetipos: { A: "montante-jusante", C: "sinal-nao-confiavel", D: "camada-alvo-errado" } },
  { n: 40, correta: "D", resumo: "Um schema de saída comum entre os subagentes torna a síntese uma operação sobre estruturas uniformes, em vez de interpretação de formatos improvisados e imprevisíveis — sequenciar a execução ou usar o mesmo modelo não impõem formato nenhum.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S3 — Multi-Agent Research System", principio: "schema de saída comum entre agentes evita que a síntese precise interpretar formatos improvisados e variáveis", topicos: ["Proveniência e Síntese", "Tool Use Schema"], arquetipos: { A: "camada-alvo-errado", B: "montante-jusante", C: "camada-alvo-errado" } },
  { n: 41, correta: "D", resumo: "O critério de retenção seletiva é a função da informação, não sua posição ou tamanho — decisões, restrições e perguntas em aberto continuam operando; uma troca já resolvida ou uma saída de tool já superada, não.", bloom: "Analisar", dificuldade: "Difícil", cenario: "S4 — Developer Productivity", principio: "retenção seletiva decide pela função da informação (ainda opera?), não por posição no histórico nem tamanho", topicos: ["Contexto Longo"], arquetipos: { A: "camada-alvo-errado", B: "sinal-nao-confiavel", C: "extremo-vs-meio" } },
  { n: 42, correta: "A", resumo: "Sentimento do cliente é sinal não confiável para decidir escalonamento — um cliente calmo pode ter um caso insolúvel e um irritado pode ter um problema trivial; o critério certo é a capacidade de resolução do próprio caso, não o humor de quem escreveu.", bloom: "Analisar", dificuldade: "Médio", cenario: "S1 — Customer Support Resolution Agent", principio: "roteamento de suporte deve se basear em capacidade de resolução do caso, não em sentimento/tom do cliente", topicos: ["Escalação de Ambiguidade"], arquetipos: { B: "camada-alvo-errado", C: "over-engineering", D: "camada-alvo-errado" } },
  { n: 43, correta: "D", resumo: "\"Investigado, nada encontrado\" e \"nunca investigado\" são estados diferentes que precisam ficar distinguíveis no relatório — é essa distinção que permite ao leitor saber onde ainda há lacuna de cobertura, em vez de assumir que tudo foi coberto.", bloom: "Analisar", dificuldade: "Médio", cenario: "S3 — Multi-Agent Research System", principio: "relatório precisa distinguir \"investigado sem achado\" de \"nunca investigado\" para expor lacunas de cobertura reais", topicos: ["Propagação de Erros"], arquetipos: { A: "vazio-ausente", B: "feature-inexistente-verossimil", C: "vazio-ausente" } },
  { n: 44, correta: "D", resumo: "Um arquivo de scratchpad no repositório sobrevive à compactação, ao fim da sessão e à troca de máquina — é o estado durável do objetivo; histórico de conversa é o que a compactação resume, e o resumo da auto-compactação é derivado e lossy.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "arquivo de scratchpad no repositório é estado durável que sobrevive a compactação, fim de sessão e troca de máquina", topicos: ["Contexto de Codebase", "Contexto Longo"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", C: "feature-inexistente-verossimil" } },
  { n: 45, correta: "B", resumo: "Diante de dois números conflitantes de fontes diferentes, o certo é apresentar os dois com fonte e data, apontando a discrepância — quem lê tem o contexto para decidir qual serve; média entre os dois produz um valor que nenhuma fonte sustenta.", bloom: "Avaliar", dificuldade: "Médio", cenario: "S3 — Multi-Agent Research System", principio: "números conflitantes se apresentam os dois, com fonte e data, apontando a discrepância — nunca média nem suposição", topicos: ["Proveniência e Síntese"], arquetipos: { A: "extremo-vs-meio", C: "sinal-nao-confiavel", D: "vazio-ausente" } },
  { n: 46, correta: "B", resumo: "Leitura dirigida guiada por uma busca prévia permite entendimento incremental de um módulo grande sem estourar a janela de contexto — carregar tudo preventivamente é exatamente o consumo que se quer evitar, e ordem alfabética não tem relação com relevância.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "leitura dirigida guiada por busca prévia evita carregar módulo inteiro preventivamente", topicos: ["Contexto de Codebase"], arquetipos: { A: "over-engineering", C: "camada-alvo-errado", D: "montante-jusante" } },
  { n: 47, correta: "C", resumo: "Compactação resume, e detalhes específicos podem sair nesse processo — o que precisa sobreviver com precisão tem que ir para uma forma durável e estruturada, fora do histórico compactável; a resposta antiga foi recebida, mas se perdeu no resumo.", bloom: "Analisar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "informação que precisa sobreviver com precisão vai para estado durável, não confia em não ser perdida na compactação", topicos: ["Contexto Longo"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 48, correta: "A", resumo: "Ambiguidade por campo, junto com a origem de cada valor extraído, permite ao revisor humano conferir só o que é duvidoso em vez de reler o documento inteiro — nota geral e versão do modelo não localizam o campo problemático.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "ambiguidade e origem POR CAMPO permitem revisão dirigida, ao contrário de um score geral do documento", topicos: ["Validação e Retry"], arquetipos: { B: "vazio-ausente", C: "camada-alvo-errado", D: "sinal-nao-confiavel" } },
  { n: 49, correta: "D", resumo: "Manter o estado da tarefa em curso explícito impede que uma interrupção desloque o contexto necessário para retomá-la depois — responder de dentro do contexto da tarefa mistura os dois assuntos, e abandonar ou recusar perdem o trabalho em curso.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "estado de tarefa explícito impede que uma interrupção desloque o contexto necessário para retomar depois", topicos: ["Contexto Longo", "Resume e Fork de Sessão"], arquetipos: { A: "camada-alvo-errado", B: "extremo-vs-meio", C: "camada-alvo-errado" } },
  { n: 50, correta: "A", resumo: "Uma falha idêntica repetida três vezes no mesmo campo é um erro determinístico, não transitório — `retryable` deveria ser falso, e a ação certa é corrigir a entrada ou escalar, não tentar de novo nem mascarar como vazio.", bloom: "Analisar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "falha idêntica e repetida é determinística (`retryable: false`), não transitória — precisa de correção ou escalonamento", topicos: ["Erros Estruturados", "Propagação de Erros"], arquetipos: { B: "vazio-ausente", C: "over-engineering", D: "camada-alvo-errado" } },
  { n: 51, correta: "C", resumo: "O problema real do relatório é não diferenciar o que é bem estabelecido do que é fracamente sustentado — exatamente o que a síntese deveria preservar; comprimento e número de citações não são o defeito, e excluir um tipo de fonte automaticamente descarta um sinal possivelmente único.", bloom: "Analisar", dificuldade: "Médio", cenario: "S3 — Multi-Agent Research System", principio: "relatório precisa diferenciar força de evidência entre afirmações, não tratar tudo com o mesmo peso", topicos: ["Proveniência e Síntese"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", D: "extremo-vs-meio" } },
  { n: 52, correta: "B", resumo: "Isolamento em subagente permite ao coordenador guardar só os resumos retornados, não a exploração bruta — reduz contexto sem reduzir cobertura, que é exatamente a restrição do enunciado; menos threads reduziria cobertura, o que viola o requisito.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S3 — Multi-Agent Research System", principio: "subagente isolado reduz contexto do coordenador sem reduzir cobertura, guardando só o resumo, não a exploração bruta", topicos: ["Spawn de Subagentes", "Contexto Longo"], arquetipos: { A: "extremo-vs-meio", C: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 53, correta: "C", resumo: "A tool deveria devolver só o que o papel do agente exige — filtrar na origem é a recomendação, dando a cada agente só o que ele precisa; codificação compacta reduz bytes mas não o ruído conceitual, e resumir depois gasta um turno limpando sujeira evitável.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "filtrar na origem (na tool) para dar a cada agente só o que seu papel precisa, não depois", topicos: ["Contexto Longo", "Descrições de Tools"], arquetipos: { A: "camada-alvo-errado", B: "montante-jusante", D: "vazio-ausente" } },
  { n: 54, correta: "B", resumo: "Para tratar divergência entre agentes de forma confiável faltam as duas metades: uma regra de resolução de conflito (ex.: preferir o dado mais específico) e a instrução de preservar a divergência quando ela for genuína, em vez de colapsá-la sempre numa única resposta.", bloom: "Analisar", dificuldade: "Difícil", cenario: "S3 — Multi-Agent Research System", principio: "tratar divergência exige regra de resolução E instrução de preservar divergência genuína — as duas coisas, não uma", topicos: ["Proveniência e Síntese"], arquetipos: { A: "camada-alvo-errado", C: "sinal-nao-confiavel", D: "extremo-vs-meio" } },
  { n: 55, correta: "B", resumo: "A inspeção de contexto mostra tokens consumidos e disponíveis por categoria, incluindo a folga reservada para a auto-compactação — tempo decorrido e contagem de mensagens não se traduzem em consumo real de tokens.", bloom: "Lembrar", dificuldade: "Fácil", cenario: "S4 — Developer Productivity", principio: "inspeção de contexto mostra consumo por categoria, incluindo o buffer reservado para auto-compact", topicos: ["Contexto Longo"], arquetipos: { A: "camada-alvo-errado", C: "probabilistico-vs-garantia", D: "camada-alvo-errado" } },
  { n: 56, correta: "A", resumo: "Quando erros continuam vazando apesar da revisão, o problema costuma ser o sinal de roteamento em si, não o limiar — é preciso descobrir o que de fato distinguia os documentos que vazaram e rotear por isso, não só mexer no limiar do mesmo sinal ruim.", bloom: "Avaliar", dificuldade: "Difícil", cenario: "S6 — Structured Data Extraction", principio: "erros vazando apesar da revisão indicam sinal de roteamento errado, não apenas limiar mal calibrado", topicos: ["Validação e Retry"], arquetipos: { B: "extremo-vs-meio", C: "over-engineering", D: "extremo-vs-meio" } },
  { n: 57, correta: "A", resumo: "Sem saber se a busca de fato executou e qual escopo cobriu, \"não encontrei\" não sustenta a conclusão \"não existe\" — é a mesma raiz da distinção entre falha de acesso e resultado vazio-válido.", bloom: "Analisar", dificuldade: "Difícil", cenario: "S3 — Multi-Agent Research System", principio: "\"não encontrei\" só vira \"não existe\" se se souber que a busca realmente executou e com qual escopo", topicos: ["Propagação de Erros"], arquetipos: { B: "camada-alvo-errado", C: "sinal-nao-confiavel", D: "extremo-vs-meio" } },
  { n: 58, correta: "D", resumo: "Separar o que veio de evidência direta do que veio de inferência é proveniência aplicada ao próprio raciocínio da síntese — o leitor sabe onde pisar firme; um número de confiança ou um disclaimer genérico não marcam qual frase específica é inferida.", bloom: "Analisar", dificuldade: "Difícil", cenario: "S3 — Multi-Agent Research System", principio: "distinguir explicitamente afirmação baseada em evidência de afirmação inferida, frase a frase", topicos: ["Proveniência e Síntese"], arquetipos: { A: "vazio-ausente", B: "extremo-vs-meio", C: "vazio-ausente" } },
  { n: 59, correta: "C", resumo: "`/compact` resume o que já ficou para trás e libera espaço mantendo o fio de trabalho em curso — é o caso de uso direto quando parte do contexto não é mais necessária; nova sessão descartaria também o que ainda é relevante.", bloom: "Aplicar", dificuldade: "Fácil", cenario: "S4 — Developer Productivity", principio: "`/compact` libera espaço resumindo o que passou, mantendo o fio de trabalho — não descarta tudo como uma sessão nova", topicos: ["Contexto Longo", "Resume e Fork de Sessão"], arquetipos: { A: "extremo-vs-meio", B: "probabilistico-vs-garantia", D: "over-engineering" } },
  { n: 60, correta: "A", resumo: "Rastrear qual subagente produziu qual achado exige as duas peças juntas — proveniência no próprio dado (identificador de agente e de fonte em cada achado) e o coordenador como ponto único por onde tudo passa; contexto maior ou revisão por outro modelo não substituem isso.", bloom: "Avaliar", dificuldade: "Difícil", cenario: "S3 — Multi-Agent Research System", principio: "rastreabilidade exige proveniência no dado E coordenador como ponto único de passagem, as duas juntas", topicos: ["Proveniência e Síntese", "Coordenador e Subagentes"], arquetipos: { B: "camada-alvo-errado", C: "camada-alvo-errado", D: "montante-jusante" } },
