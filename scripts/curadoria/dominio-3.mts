const D3: Curadoria[] = [
  { n: 1, correta: "A", resumo: "Managed settings tem a maior precedência na hierarquia (Managed > User > Project > Local) e pode travar flags como `--dangerously-skip-permissions` para a organização inteira, independente do que usuário ou projeto configurem.", bloom: "Lembrar", dificuldade: "Fácil", cenario: "S4 — Developer Productivity", principio: "managed settings tem precedência máxima e pode bloquear flags perigosas para toda a organização", topicos: ["Hierarquia CLAUDE.md"], arquetipos: { B: "camada-alvo-errado", C: "extremo-vs-meio", D: "camada-alvo-errado" } },
  { n: 2, correta: "C", resumo: "Uma regra por caminho com glob carrega orientação só quando o arquivo casa com o padrão — é o mecanismo desenhado para orientação condicional, diferente de inflar o `CLAUDE.md` (sempre carregado) ou de um hook (que só bloqueia, não ensina).", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "path-specific rule com glob aplica orientação condicional só aos arquivos que casam com o padrão", topicos: ["Path Rules"], arquetipos: { A: "extremo-vs-meio", B: "camada-alvo-errado", D: "probabilistico-vs-garantia" } },
  { n: 3, correta: "B", resumo: "Em um pipeline de CI, a sessão precisa rodar em modo não interativo (`-p`) e devolver `--output-format json` para que o passo seguinte consiga interpretar a saída por programa — sem `-p`, o job travaria esperando um input humano que não existe.", bloom: "Aplicar", dificuldade: "Fácil", cenario: "S5 — Claude Code for CI", principio: "`-p` + `--output-format json` habilitam execução não interativa e saída parseável em CI", topicos: ["CI/CD"], arquetipos: { A: "probabilistico-vs-garantia", C: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 4, correta: "A", resumo: "A ordem de avaliação de regras de permissão é deny → ask → allow, e a regra mais restritiva que casar é a que vale — não é o escopo que decide o conflito, é o tipo da regra.", bloom: "Lembrar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "deny é avaliado antes de allow — a regra mais restritiva sempre vence", topicos: ["Hierarquia CLAUDE.md"], arquetipos: { B: "camada-alvo-errado", C: "extremo-vs-meio", D: "extremo-vs-meio" } },
  { n: 5, correta: "D", resumo: "Em uma regra de permissão de Bash, o espaço antes do `*` faz parte do padrão — `Bash(ls *)` casa com `ls -la` mas não com `lsof`, porque o espaço literal precisa existir no comando.", bloom: "Analisar", dificuldade: "Difícil", cenario: "S4 — Developer Productivity", principio: "espaço em uma regra de wildcard de Bash é literal e faz parte do padrão casado", topicos: ["Hierarquia CLAUDE.md"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", C: "feature-inexistente-verossimil" } },
  { n: 6, correta: "D", resumo: "O uso de `--dangerously-skip-permissions` tem casos legítimos — devcontainer ou VM descartável sem risco real, pipeline automatizado sem humano para aprovar, e trabalho de risco muito baixo e bem delimitado — não é um \"nunca\" absoluto nem exclusivo de um modo automático de CI.", bloom: "Analisar", dificuldade: "Médio", cenario: "S5 — Claude Code for CI", principio: "`--dangerously-skip-permissions` tem casos legítimos restritos a ambientes descartáveis/isolados ou automação sem humano disponível", topicos: ["CI/CD"], arquetipos: { A: "extremo-vs-meio", B: "camada-alvo-errado", C: "feature-inexistente-verossimil" } },
  { n: 7, correta: "C", resumo: "O sandbox não protege quando o próprio modelo raciocina que o sandbox é o obstáculo e decide removê-lo — com `--dangerously-skip-permissions` essa decisão é auto-aprovada, e o sandbox vira algo que o modelo pode simplesmente desativar.", bloom: "Analisar", dificuldade: "Difícil", cenario: "S4 — Developer Productivity", principio: "sandbox + auto-aprovação total permite que o modelo raciocine para remover a própria proteção", topicos: ["Hierarquia CLAUDE.md"], arquetipos: { A: "feature-inexistente-verossimil", B: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 8, correta: "D", resumo: "Para eliminar um falso positivo sistemático de um revisor automatizado, o critério precisa incluir tanto quando marcar quanto quando não marcar (ex.: só sinalizar SQL injection quando a entrada vai direto para a query sem parametrização, nunca em ORM/prepared statement), como contexto persistente em toda revisão.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "critério de revisão precisa de inclusão e exclusão explícitas, como contexto persistente — não apenas \"confira de novo\"", topicos: ["CI/CD", "Path Rules"], arquetipos: { A: "sinal-nao-confiavel", B: "sinal-nao-confiavel", C: "camada-alvo-errado" } },
  { n: 9, correta: "D", resumo: "Um slash command versionado no projeto encapsula prompt, restrições e formato de saída esperado, e fica disponível por nome para o time inteiro — diferente de hook (reage a tool call), permission rule (só autoriza) ou `CLAUDE.md` (sempre carregado, não invocado sob demanda).", bloom: "Aplicar", dificuldade: "Fácil", cenario: "S4 — Developer Productivity", principio: "slash command versionado é o workflow reutilizável e parametrizável, invocável por nome", topicos: ["Commands e Skills"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", C: "camada-alvo-errado" } },
  { n: 10, correta: "B", resumo: "Para explorar um repositório grande sem estourar a janela de contexto, o caminho é Glob para localizar candidatos por nome, Grep para achar as ocorrências, e Read só para carregar o que a busca apontou — entendimento incremental com custo de contexto controlado.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "exploração incremental (Glob → Grep → Read do necessário) evita estourar a janela de contexto num repositório grande", topicos: ["Contexto de Codebase", "CI/CD"], arquetipos: { A: "extremo-vs-meio", C: "camada-alvo-errado", D: "extremo-vs-meio" } },
  { n: 11, correta: "A", resumo: "`CLAUDE.md` existe para ser o contexto persistente do projeto, carregado automaticamente em toda sessão, sem que ninguém precise colar nada manualmente.", bloom: "Lembrar", dificuldade: "Fácil", cenario: "S4 — Developer Productivity", principio: "`CLAUDE.md` é carregado automaticamente em toda sessão como contexto persistente do projeto", topicos: ["Hierarquia CLAUDE.md"], arquetipos: { B: "camada-alvo-errado", C: "camada-alvo-errado", D: "vazio-ausente" } },
  { n: 12, correta: "D", resumo: "Gerar testes de melhor qualidade exige dar como contexto os arquivos de teste existentes, as convenções de fixture do time, e um critério explícito do que separa uma asserção comportamental de uma trivial — subir o limiar de cobertura ou gerar mais testes triviais só piora a métrica sem melhorar a qualidade.", bloom: "Analisar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "qualidade de teste gerado melhora com contexto de convenção + critério explícito de asserção comportamental vs. trivial", topicos: ["Refinamento Iterativo"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", C: "vazio-ausente" } },
  { n: 13, correta: "A", resumo: "Preferências pessoais específicas de um projeto, que nunca devem ir para o repositório compartilhado, ficam em `.claude/settings.local.json` — escopo local, não versionado.", bloom: "Lembrar", dificuldade: "Fácil", cenario: "S4 — Developer Productivity", principio: "`settings.local.json` é o escopo pessoal de um projeto específico, não versionado", topicos: ["Hierarquia CLAUDE.md"], arquetipos: { B: "camada-alvo-errado", C: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 14, correta: "B", resumo: "O nome nu de uma tool numa regra de permissão, sem parênteses, cobre tudo — nenhuma filtragem por domínio ou padrão; `Read` sozinho significa toda leitura, de qualquer arquivo.", bloom: "Lembrar", dificuldade: "Fácil", cenario: "S4 — Developer Productivity", principio: "nome nu de tool numa regra de permissão é cobertura total, sem filtro", topicos: ["Hierarquia CLAUDE.md"], arquetipos: { A: "extremo-vs-meio", C: "feature-inexistente-verossimil", D: "feature-inexistente-verossimil" } },
  { n: 15, correta: "D", resumo: "A tool WebFetch é controlada por regra de domínio (`WebFetch(domain:example.com)`, com allow/ask/deny) — bloquear `curl` no shell não a alcança, porque ela não passa pelo shell.", bloom: "Lembrar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "regra de permissão de WebFetch é por domínio, não via Bash/curl", topicos: ["Hierarquia CLAUDE.md"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", C: "camada-alvo-errado" } },
  { n: 16, correta: "A", resumo: "O modo `acceptEdits` aceita automaticamente as edições de arquivo durante a sessão, mas comandos de shell continuam pedindo confirmação — diferente de `plan` (nem edita), `dontAsk` (nega o que não está pré-aprovado) ou `bypassPermissions` (pula tudo, inclusive Bash).", bloom: "Lembrar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "`acceptEdits` só auto-aceita edição de arquivo; Bash continua pedindo confirmação", topicos: ["Plan Mode"], arquetipos: { B: "extremo-vs-meio", C: "camada-alvo-errado", D: "extremo-vs-meio" } },
  { n: 17, correta: "A", resumo: "Organizar orientação por quando ela se aplica — sempre-relevante em `CLAUDE.md`, condicional em path-specific rules/skills, e conteúdo compartilhado por import em vez de duplicado — ataca o custo de contexto e o efeito \"lost in the middle\" ao mesmo tempo.", bloom: "Avaliar", dificuldade: "Difícil", cenario: "S4 — Developer Productivity", principio: "separar orientação por \"sempre relevante\" vs. \"condicional por caminho\" reduz custo de contexto e \"lost in the middle\"", topicos: ["Hierarquia CLAUDE.md", "Path Rules"], arquetipos: { B: "probabilistico-vs-garantia", C: "camada-alvo-errado", D: "enumerar-vs-generalizar" } },
  { n: 18, correta: "C", resumo: "Para evitar que uma execução em CI gaste muito mais tokens do que o orçado, a configuração precisa de limites explícitos de custo e de turnos que impeçam uma execução descontrolada — um prompt mais curto ou um runner mais rápido não limitam o gasto.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S5 — Claude Code for CI", principio: "limites explícitos de custo/turnos previnem execução descontrolada em CI", topicos: ["CI/CD"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 19, correta: "C", resumo: "Um job de revisão automatizada de PR deve restringir o acesso a tools desnecessárias (para não poder editar arquivos) e produzir saída estruturada adequada para processamento a jusante — reverter depois ou parsear markdown livre são soluções frágeis.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S5 — Claude Code for CI", principio: "job de CI de revisão precisa restringir tools + saída estruturada, não markdown livre nem correção reativa", topicos: ["CI/CD"], arquetipos: { A: "probabilistico-vs-garantia", B: "montante-jusante", D: "camada-alvo-errado" } },
  { n: 20, correta: "A", resumo: "Para achar arquivos cujo nome corresponde a um padrão, a tool certa é Glob — Read carrega um arquivo já conhecido, Grep busca dentro do conteúdo, e WebSearch busca na internet.", bloom: "Lembrar", dificuldade: "Fácil", cenario: "S4 — Developer Productivity", principio: "Glob busca arquivos por nome/padrão, não por conteúdo", topicos: ["Built-in Tools", "CI/CD"], arquetipos: { B: "camada-alvo-errado", C: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 21, correta: "D", resumo: "O feedback que mais corrige um erro específico combina um exemplo concreto de entrada-saída com um apontamento pontual da falha — repetir a instrução vaga, reescrever do zero ou dar um julgamento sem conteúdo acionável não mudam o próximo resultado.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "exemplo concreto entrada-saída + feedback pontual sobre a falha específica corrige melhor que instrução vaga", topicos: ["Refinamento Iterativo"], arquetipos: { A: "probabilistico-vs-garantia", B: "extremo-vs-meio", C: "vazio-ausente" } },
  { n: 22, correta: "B", resumo: "Ao corrigir vários problemas de uma vez, descrever todos os oito juntos permite uma correção coerente, em que a correção de um não quebra outro — corrigir um de cada vez multiplica turnos e arrisca regressão entre correções.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "descrições de problema em lote (batched) permitem correção consolidada e coerente, sem regressão entre correções", topicos: ["Refinamento Iterativo"], arquetipos: { A: "sinal-nao-confiavel", C: "extremo-vs-meio", D: "camada-alvo-errado" } },
  { n: 23, correta: "C", resumo: "Existe uma allowlist de servidores MCP exclusiva de managed settings — indefinida significa sem restrição, array vazio significa travar todos os servidores MCP — e uma denylist com precedência sobre ela; nenhum escopo mais baixo consegue essa restrição organizacional.", bloom: "Lembrar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "allowlist/denylist de servidores MCP por organização só existe em managed settings", topicos: ["MCP Servers", "Hierarquia CLAUDE.md"], arquetipos: { A: "camada-alvo-errado", B: "extremo-vs-meio", D: "camada-alvo-errado" } },
  { n: 24, correta: "D", resumo: "Configurar o valor de retenção de sessão como 0 apaga todas as transcrições no início e desabilita a persistência por completo — nenhum `.jsonl` novo é gravado, `/resume` não mostra nada, e hooks recebem `transcript_path` vazio.", bloom: "Lembrar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "retenção de sessão configurada como 0 desabilita persistência de transcrição por completo", topicos: ["Hierarquia CLAUDE.md"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", C: "camada-alvo-errado" } },
  { n: 25, correta: "D", resumo: "Para buscar um padrão dentro do conteúdo de arquivos, a tool certa é Grep — Read carrega um arquivo específico, Glob acha por nome, e `find` via Bash exige permissão de shell desproporcional.", bloom: "Lembrar", dificuldade: "Fácil", cenario: "S4 — Developer Productivity", principio: "Grep busca padrão dentro do conteúdo de arquivos", topicos: ["Built-in Tools"], arquetipos: { A: "camada-alvo-errado", B: "over-engineering", C: "camada-alvo-errado" } },
  { n: 26, correta: "C", resumo: "Quando o contexto está quase cheio mas o trabalho em andamento não pode ser perdido, `/compact` resume a conversa para liberar tokens preservando a linha de trabalho — `/rewind` voltaria no tempo e `/clear` apagaria tudo.", bloom: "Aplicar", dificuldade: "Fácil", cenario: "S4 — Developer Productivity", principio: "`/compact` libera tokens resumindo a conversa, sem descartar o progresso como `/clear` faria", topicos: ["Resume e Fork de Sessão", "Contexto Longo"], arquetipos: { A: "vazio-ausente", B: "camada-alvo-errado", D: "extremo-vs-meio" } },
  { n: 27, correta: "C", resumo: "Para zerar a conversa sem herdar nada da tarefa anterior, mas mantendo a orientação de projeto, `/clear` limpa a conversa atual sem apagar `CLAUDE.md` nem AutoMemory — reiniciar o terminal não é necessário para isso.", bloom: "Lembrar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "`/clear` zera a conversa sem afetar `CLAUDE.md`/AutoMemory", topicos: ["Resume e Fork de Sessão"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", D: "over-engineering" } },
  { n: 28, correta: "B", resumo: "Uma orientação de projeto que precisa valer para toda sessão no repositório e ser revisável pelo time em code review deve ir para o `CLAUDE.md` versionado — settings pessoais e `settings.local.json` não chegam aos colegas, e comentário em YAML de CI não é lido como contexto.", bloom: "Aplicar", dificuldade: "Fácil", cenario: "S4 — Developer Productivity", principio: "`CLAUDE.md` versionado é visível em code review; settings pessoais/locais não", topicos: ["Hierarquia CLAUDE.md"], arquetipos: { A: "camada-alvo-errado", C: "feature-inexistente-verossimil", D: "camada-alvo-errado" } },
  { n: 29, correta: "C", resumo: "Para voltar a um ponto anterior dentro da mesma sessão, descartando um erro sem perder os turnos bons antes dele, o comando certo é `/rewind` — `/compact` só resume, `/resume` retoma outra sessão, e `/clear` apagaria tudo.", bloom: "Lembrar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "`/rewind` restaura a sessão atual a um ponto anterior específico", topicos: ["Resume e Fork de Sessão"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", D: "extremo-vs-meio" } },
  { n: 30, correta: "C", resumo: "Uma regra por caminho com glob carrega quando os arquivos casam com o padrão e fica invisível no resto do tempo — é o mecanismo de orientação condicional; deny bloqueia em vez de orientar, e uma skill exige que alguém lembre de invocar.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "path-specific rule é o mecanismo certo para orientação condicional por caminho, presente só quando relevante", topicos: ["Path Rules"], arquetipos: { A: "extremo-vs-meio", B: "probabilistico-vs-garantia", D: "camada-alvo-errado" } },
  { n: 31, correta: "A", resumo: "São duas configurações distintas: uma sobrescreve o modelo padrão de todas as sessões, e outra restringe quais modelos podem ser escolhidos via `/model`, `--model` ou variável de ambiente — nenhuma das duas é exclusiva de managed settings, e a restrição de seletor não afeta a opção \"Default\".", bloom: "Analisar", dificuldade: "Difícil", cenario: "S4 — Developer Productivity", principio: "modelo padrão e restrição de seleção de modelo são duas configurações independentes, nenhuma exclusiva de managed settings", topicos: ["Hierarquia CLAUDE.md"], arquetipos: { B: "camada-alvo-errado", C: "camada-alvo-errado", D: "feature-inexistente-verossimil" } },
  { n: 32, correta: "C", resumo: "Para bloquear acesso a arquivos sensíveis sem exceção, a regra certa é deny — avaliada primeiro e a mais restritiva; `ask` deixaria uma porta aberta, `.gitignore` só impede commit (não leitura), e instrução em `CLAUDE.md` é enforcement por prompt.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "deny é a única regra que garante bloqueio sem exceção — não `ask`, `.gitignore` ou instrução em prompt", topicos: ["Hierarquia CLAUDE.md"], arquetipos: { A: "probabilistico-vs-garantia", B: "camada-alvo-errado", D: "probabilistico-vs-garantia" } },
  { n: 33, correta: "D", resumo: "`context: fork` no frontmatter de uma skill ou slash command faz ela rodar em contexto de subagente isolado, evitando que o processamento intermediário contamine o estado da sessão principal — só a conclusão volta.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "`context: fork` isola execução de workflow em subagente, evitando contaminar a sessão principal", topicos: ["Commands e Skills", "Spawn de Subagentes"], arquetipos: { A: "camada-alvo-errado", B: "montante-jusante", C: "feature-inexistente-verossimil" } },
  { n: 34, correta: "A", resumo: "Para que um consumidor a jusante receba registros, não prosa, a execução precisa ser não interativa com saída JSON e um prompt que defina exatamente os campos de cada achado — um registro por achado, tipado.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S5 — Claude Code for CI", principio: "execução não interativa + JSON + campos definidos no prompt produzem saída consumível a jusante", topicos: ["CI/CD"], arquetipos: { B: "vazio-ausente", C: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 35, correta: "A", resumo: "Um job de revisão automatizada precisa carregar o guia de padrões correto para os arquivos em questão — sem esse escopo, ele aplica a orientação errada, e nem permissão ampla nem formato de saída resolvem esse problema de contexto.", bloom: "Analisar", dificuldade: "Médio", cenario: "S5 — Claude Code for CI", principio: "job de revisão de CI precisa carregar explicitamente o guia de padrões certo para o escopo dos arquivos revisados", topicos: ["CI/CD", "Path Rules"], arquetipos: { B: "camada-alvo-errado", C: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 36, correta: "C", resumo: "Existe uma configuração que desativa todos os hooks (e a status line customizada) de uma vez, e em managed settings existe um modo de bloqueio em que só hooks de managed settings e do SDK rodam, travando os de usuário/projeto/plugin.", bloom: "Lembrar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "hooks podem ser desligados globalmente, e managed settings pode travar quais hooks rodam na organização", topicos: ["Hooks"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", D: "over-engineering" } },
  { n: 37, correta: "C", resumo: "Por padrão, o seletor de arquivo com `@` esconde os arquivos que batem com `.gitignore`; uma configuração permite mostrar todos os arquivos, inclusive os ignorados pelo git.", bloom: "Lembrar", dificuldade: "Fácil", cenario: "S4 — Developer Productivity", principio: "seletor `@` esconde arquivos gitignored por padrão, configurável para mostrar todos", topicos: ["Hierarquia CLAUDE.md"], arquetipos: { A: "extremo-vs-meio", B: "camada-alvo-errado", D: "vazio-ausente" } },
  { n: 38, correta: "C", resumo: "O sandbox só se aplica às tools de Bash — ele não restringe Read, Write, Edit, WebSearch, WebFetch, tools MCP, hooks ou comandos internos; assumir que ele cobre tudo é a suposição perigosa que faz alguém desenhar um controle de segurança que na verdade não existe.", bloom: "Analisar", dificuldade: "Difícil", cenario: "S4 — Developer Productivity", principio: "sandbox cobre só a execução via Bash — não é uma proteção geral para todas as tools", topicos: ["Hierarquia CLAUDE.md"], arquetipos: { A: "camada-alvo-errado", B: "sinal-nao-confiavel", D: "extremo-vs-meio" } },
  { n: 39, correta: "B", resumo: "Escopo pequeno, risco baixo e verificação automática já existente pedem execução direta, escolhida pela proporção entre risco e cerimônia — plan mode, workflow multi-fase ou tratar toda mudança como arquitetural são over-engineering para esse caso.", bloom: "Avaliar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "escolher o mecanismo de revisão pela proporção entre escopo, risco e verificação disponível — nem tudo pede o mecanismo mais pesado", topicos: ["Plan Mode"], arquetipos: { A: "probabilistico-vs-garantia", C: "extremo-vs-meio", D: "over-engineering" } },
  { n: 40, correta: "B", resumo: "Um pedido de correção de bug bem especificado declara o sintoma, como reproduzir, o escopo de arquivo, o que não deve ser mudado e a condição de pronto — \"e quaisquer problemas relacionados\" amplia o escopo, e advérbios como \"com cuidado\" não são critério.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "critério explícito de correção inclui o que NÃO mudar, além do sintoma, reprodução, escopo e condição de pronto", topicos: ["Critérios Explícitos", "CI/CD"], arquetipos: { A: "extremo-vs-meio", C: "vazio-ausente", D: "camada-alvo-errado" } },
  { n: 41, correta: "A", resumo: "`/context` mostra quantos tokens já foram consumidos na sessão atual e quantos ainda estão disponíveis, detalhado por categoria (mensagens, system, tools, skills).", bloom: "Lembrar", dificuldade: "Fácil", cenario: "S4 — Developer Productivity", principio: "`/context` detalha consumo de tokens da sessão por categoria", topicos: ["Contexto Longo"], arquetipos: { B: "camada-alvo-errado", C: "feature-inexistente-verossimil", D: "camada-alvo-errado" } },
  { n: 42, correta: "A", resumo: "O buffer de auto-compact é uma parte reservada da janela de contexto que garante folga suficiente para resumir o histórico quando o limite se aproxima — por isso uma sessão nova já aparece com parte do espaço reservada, sem ser bug.", bloom: "Lembrar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "buffer de auto-compact reserva espaço de contexto para permitir resumir o histórico antes do limite", topicos: ["Contexto Longo"], arquetipos: { B: "camada-alvo-errado", C: "sinal-nao-confiavel", D: "feature-inexistente-verossimil" } },
  { n: 43, correta: "A", resumo: "Uma preferência pessoal que deve valer em todos os projetos, mas só naquela máquina, vai em `~/.claude/settings.json` — escopo de usuário; project é compartilhado via git, managed é organizacional, e local vale só para um projeto.", bloom: "Lembrar", dificuldade: "Fácil", cenario: "S4 — Developer Productivity", principio: "`~/.claude/settings.json` (escopo de usuário) vale para todos os projetos, só naquela máquina", topicos: ["Hierarquia CLAUDE.md"], arquetipos: { B: "camada-alvo-errado", C: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 44, correta: "A", resumo: "A seção de variáveis de ambiente no `settings.json` é aplicada a toda sessão, útil para segredos, configuração de tool e feature flags — diferente de hook por tool call, export manual no shell (depende de lembrar) ou `CLAUDE.md` (informa o modelo, não define ambiente de execução).", bloom: "Lembrar", dificuldade: "Fácil", cenario: "S4 — Developer Productivity", principio: "variáveis de ambiente em `settings.json` são aplicadas automaticamente a toda sessão", topicos: ["Hierarquia CLAUDE.md"], arquetipos: { B: "camada-alvo-errado", C: "sinal-nao-confiavel", D: "camada-alvo-errado" } },
  { n: 45, correta: "B", resumo: "Para auditar toda invocação de Bash de forma confiável, um hook `PostToolUse` roda um comando depois de cada uso da tool — permission rule só autoriza ou nega, e pedir ao próprio modelo para logar é enforcement por prompt, que falha silenciosamente.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "hook `PostToolUse` registra toda invocação de uma tool de forma confiável, diferente de pedir ao modelo para logar", topicos: ["Hooks"], arquetipos: { A: "camada-alvo-errado", C: "camada-alvo-errado", D: "probabilistico-vs-garantia" } },
  { n: 46, correta: "B", resumo: "Um prefixo `/` numa regra de Read/Edit é relativo à raiz do projeto — ancorado onde quer que fique a raiz do repositório, portável entre máquinas; diretório atual não tem prefixo, home é `~/`, raiz do sistema é `//`.", bloom: "Lembrar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "prefixo `/` em regra de Read/Edit é relativo à raiz do projeto, portável entre máquinas", topicos: ["Hierarquia CLAUDE.md"], arquetipos: { A: "camada-alvo-errado", C: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 47, correta: "D", resumo: "Para uma regra que sempre deve apontar para o diretório home, independente de qual projeto está aberto, o prefixo certo é `~/` — `/` é raiz do projeto, sem prefixo é o diretório de lançamento, e `//` é a raiz do sistema de arquivos.", bloom: "Lembrar", dificuldade: "Fácil", cenario: "S4 — Developer Productivity", principio: "prefixo `~/` em regra de Read/Edit sempre aponta para o diretório home, independente do projeto", topicos: ["Hierarquia CLAUDE.md"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", C: "camada-alvo-errado" } },
  { n: 48, correta: "D", resumo: "Para decidir de forma confiável se um build deve falhar, o campo de severidade precisa vir em JSON estruturado e tipado, com a decisão tomada pelo script — humano no meio quebra a automação, e buscar a palavra \"blocker\" por texto casa até com frases que dizem que não há blockers.", bloom: "Analisar", dificuldade: "Médio", cenario: "S5 — Claude Code for CI", principio: "decisão de falhar o build deve vir de um campo estruturado e tipado, não de texto livre ou comportamento não garantido", topicos: ["CI/CD"], arquetipos: { A: "camada-alvo-errado", B: "sinal-nao-confiavel", C: "sinal-nao-confiavel" } },
  { n: 49, correta: "B", resumo: "Além de aprovar todos os servidores listados em `.mcp.json` de uma vez, existe uma configuração para aprovar servidores específicos individualmente (e uma para rejeitar servidores específicos) — não é tudo-ou-nada.", bloom: "Lembrar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "managed settings permite aprovar servidores MCP de `.mcp.json` individualmente, não só todos de uma vez", topicos: ["MCP Servers", "Hierarquia CLAUDE.md"], arquetipos: { A: "extremo-vs-meio", C: "feature-inexistente-verossimil", D: "camada-alvo-errado" } },
  { n: 50, correta: "D", resumo: "O modo `dontAsk` nega automaticamente qualquer tool que não esteja pré-aprovada via `/permissions` ou regras de allow, em vez de interromper pedindo confirmação — diferente de `bypassPermissions` (aprova tudo) ou `acceptEdits` (aceita edição).", bloom: "Lembrar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "`dontAsk` nega automaticamente o que não está pré-aprovado, em vez de perguntar", topicos: ["Plan Mode"], arquetipos: { A: "extremo-vs-meio", B: "extremo-vs-meio", C: "camada-alvo-errado" } },
  { n: 51, correta: "B", resumo: "Para acumular descobertas ao longo de várias sessões sem estourar contexto, a combinação recomendada é isolamento de subagente, arquivos de scratchpad e leitura dirigida de arquivo — o scratchpad é o estado durável entre sessões; colar a transcrição inteira ou reexplorar do zero desperdiçam exatamente o que se quer evitar.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "arquivo de scratchpad como estado durável entre sessões sustenta exploração além dos limites de contexto de uma sessão só", topicos: ["Contexto Longo", "Contexto de Codebase"], arquetipos: { A: "montante-jusante", C: "camada-alvo-errado", D: "extremo-vs-meio" } },
  { n: 52, correta: "B", resumo: "Para garantir que um job de CI nunca escreva no repositório, a garantia vem de regras de permissão negando Bash/Edit/Write — imposta pela configuração, independente do que o modelo decida; uma linha no system prompt continua sendo instrução, não garantia.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S5 — Claude Code for CI", principio: "regra de permissão negando ferramentas é garantia por configuração; instrução em prompt não é", topicos: ["CI/CD", "Hierarquia CLAUDE.md"], arquetipos: { A: "probabilistico-vs-garantia", C: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 53, correta: "C", resumo: "Uma sessão iniciada via Remote Control ou Claude Code for Web pode ser continuada localmente pela IDE — não exige exportar nem colar a transcrição, e as duas formas de sessão não ficam permanentemente isoladas uma da outra.", bloom: "Lembrar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "sessão iniciada remotamente (Web/Remote Control) pode ser continuada localmente na IDE", topicos: ["Resume e Fork de Sessão"], arquetipos: { A: "over-engineering", B: "extremo-vs-meio", D: "camada-alvo-errado" } },
  { n: 54, correta: "D", resumo: "`CLAUDE.md` suporta importar outro arquivo, mantendo uma única fonte da verdade para conteúdo compartilhado entre projetos, sem duplicar — symlink é truque de sistema de arquivos, copiar cria cópias divergentes, e um hook que concatena arquivos reinventa algo que já existe pronto.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "import em `CLAUDE.md` compartilha conteúdo entre projetos sem duplicar nem divergir", topicos: ["Hierarquia CLAUDE.md"], arquetipos: { A: "camada-alvo-errado", B: "montante-jusante", C: "over-engineering" } },
  { n: 55, correta: "A", resumo: "`mcp__<server_name>` sozinho casa com qualquer tool fornecida por aquele servidor — existe também a forma `mcp__<server>__<tool>` para uma tool específica, e um glob na posição do nome da tool para cobrir todos os servidores de uma vez.", bloom: "Lembrar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "`mcp__<server_name>` sem nome de tool cobre todas as tools daquele servidor", topicos: ["MCP Servers"], arquetipos: { B: "camada-alvo-errado", C: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 56, correta: "D", resumo: "O pipeline de CI já sabe qual é o diff da mudança — passar essa lista como escopo explícito para o agente é determinístico e barato, diferente de deixá-lo descobrir sozinho, usar critério vago (\"o que parecer relevante\") ou aumentar o limite de turnos para revisar o repositório inteiro.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S5 — Claude Code for CI", principio: "escopo explícito (o diff já conhecido pelo pipeline) é determinístico; descoberta ou critério vago não são", topicos: ["CI/CD"], arquetipos: { A: "over-engineering", B: "sinal-nao-confiavel", C: "camada-alvo-errado" } },
  { n: 57, correta: "B", resumo: "Uma regra absoluta como \"nunca contra produção sem ticket aprovado\" é uma garantia, e garantia se implementa como gate/hook que verifica um estado externo (o ticket existe?) — não como texto que o modelo lê, mesmo num `CLAUDE.md` sempre carregado ou num `ask` que depende do humano avaliar certo toda vez.", bloom: "Analisar", dificuldade: "Médio", cenario: "S5 — Claude Code for CI", principio: "requisito absoluto (\"nunca sem X\") precisa de gate/hook que verifique estado externo, não instrução textual", topicos: ["Enforcement de Workflow", "CI/CD"], arquetipos: { A: "camada-alvo-errado", C: "probabilistico-vs-garantia", D: "probabilistico-vs-garantia" } },
  { n: 58, correta: "C", resumo: "Existe uma configuração de idioma de resposta preferido no `settings.json`, ao lado do output style que ajusta o system prompt — o modelo não lê variáveis de ambiente por conta própria, permissões não têm dimensão de idioma, e `/rename` só rotula a sessão.", bloom: "Lembrar", dificuldade: "Fácil", cenario: "S4 — Developer Productivity", principio: "idioma de resposta preferido é uma configuração dedicada em `settings.json`", topicos: ["Hierarquia CLAUDE.md"], arquetipos: { A: "feature-inexistente-verossimil", B: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 59, correta: "B", resumo: "Um exemplo concreto de entrada e saída esperada ancora formato e nomenclatura de um jeito que instrução vaga (\"mais consistente\", \"siga nosso estilo\") não consegue — é o mesmo mecanismo de few-shot aplicado ao refinamento iterativo.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "exemplo concreto entrada→saída (few-shot) ancora formato/nomenclatura melhor que instrução vaga de estilo", topicos: ["Refinamento Iterativo", "Few-Shot"], arquetipos: { A: "vazio-ausente", C: "camada-alvo-errado", D: "probabilistico-vs-garantia" } },
  { n: 60, correta: "B", resumo: "Quando a orientação só vale para um diretório específico (ex.: `db/migrations/`) e é consultiva, não uma garantia rígida, os dois critérios juntos apontam para uma path-specific rule — `CLAUDE.md` carregaria sempre, negar edição impediria o trabalho, e um hook implicaria garantia onde o enunciado pede só orientação.", bloom: "Analisar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "orientação condicional por caminho E consultiva (não garantia) aponta para path-specific rule, não `CLAUDE.md` nem hook", topicos: ["Path Rules"], arquetipos: { A: "camada-alvo-errado", C: "extremo-vs-meio", D: "over-engineering" } },
];

