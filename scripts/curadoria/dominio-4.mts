import type { Curadoria } from "../tipoCuradoria";

const D4: Curadoria[] = [
  { n: 1, correta: "B", resumo: "Quando nenhum resultado por documento precisa ser imediato e o prazo aceitável é o próximo dia útil, o desenho certo é processamento em batch — nada fica bloqueado esperando, e é exatamente a definição do caso de uso de batch.", bloom: "Aplicar", dificuldade: "Fácil", cenario: "S6 — Structured Data Extraction", principio: "batch se aplica quando nada bloqueia esperando resposta imediata e o prazo é folgado", topicos: ["Batch Processing"], arquetipos: { A: "camada-alvo-errado", C: "extremo-vs-meio", D: "over-engineering" } },
  { n: 2, correta: "C", resumo: "Revisar várias preocupações diferentes num único prompt faz elas competirem por atenção; separar em prompts focados, cada um com seu próprio few-shot, evita essa perda de recall entre preocupações concorrentes.", bloom: "Avaliar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "separar preocupações em prompts dedicados com few-shot próprio evita competição por atenção e perda de recall", topicos: ["Revisão Multi-Instância", "Few-Shot"], arquetipos: { A: "extremo-vs-meio", B: "camada-alvo-errado", D: "enumerar-vs-generalizar" } },
  { n: 3, correta: "C", resumo: "Um schema com campos opcionais e valores nulos deixa o modelo representar informação ausente ou ambígua com precisão — um campo obrigatório onde o dado não existe força a invenção de um valor plausível.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "campos opcionais/nullable no schema evitam que o modelo invente valor para representar dado ausente", topicos: ["Tool Use Schema"], arquetipos: { A: "camada-alvo-errado", B: "probabilistico-vs-garantia", D: "montante-jusante" } },
  { n: 4, correta: "B", resumo: "Quando a saída estruturada é cortada no meio por causa do tamanho, a correção é dividir em chamadas menores e mesclar as estruturas resultantes — aumentar `max_tokens` além do limite prático não é opção, e pedir concisão sacrifica achados reais.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "truncamento de saída estruturada se resolve dividindo e mesclando, não aumentando `max_tokens`", topicos: ["Validação e Retry"], arquetipos: { A: "feature-inexistente-verossimil", C: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 5, correta: "D", resumo: "Exemplos few-shot devem incluir tanto casos bons quanto ruins, inclusive casos de borda (como \"um punhado de sal\") — isso ancora o modelo em resultados consistentes e reduz alucinação em situações informais ou ambíguas.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S1 — Customer Support Resolution Agent", principio: "few-shot precisa de exemplos bons E ruins, incluindo casos de borda, para ancorar comportamento consistente", topicos: ["Few-Shot"], arquetipos: { A: "feature-inexistente-verossimil", B: "camada-alvo-errado", C: "camada-alvo-errado" } },
  { n: 6, correta: "B", resumo: "Entre os métodos de garantir conformidade estrutural, tool use com um JSON Schema fica no topo do rigor — o modelo gera os argumentos para caber no schema declarado; prefill, retry dos casos que falham ou reparo de JSON malformado são remendos que convivem com o problema.", bloom: "Analisar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "tool use + JSON Schema é o método de maior rigor de conformidade estrutural, entre os citados", topicos: ["Tool Use Schema"], arquetipos: { A: "probabilistico-vs-garantia", C: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 7, correta: "B", resumo: "Convenções específicas do projeto, padrões aceitos e critérios de exclusão devem ser fornecidos como contexto persistente, aplicado em toda revisão — não repetidos a cada pedido nem corrigidos só depois, no pós-processamento.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "convenções e critérios de exclusão como contexto persistente aplicado em toda revisão, não por pedido pontual", topicos: ["Critérios Explícitos"], arquetipos: { A: "camada-alvo-errado", C: "montante-jusante", D: "camada-alvo-errado" } },
  { n: 8, correta: "C", resumo: "Para datas em formatos variados e às vezes ambíguos (como \"1/5/24\"), a regra é converter para ISO 8601, preferir a interpretação ano-mês-dia quando ambíguo, e marcar um flag de incerteza — regra, exemplos resolvidos e sinalização de dúvida juntos.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "normalização de data usa regra + exemplos + flag de ambiguidade, não recusa nem \"consistência\" vaga", topicos: ["Tool Use Schema"], arquetipos: { A: "montante-jusante", B: "extremo-vs-meio", D: "vazio-ausente" } },
  { n: 9, correta: "D", resumo: "Um prompt vago faz o modelo adivinhar um padrão em vez de aplicar uma regra explícita, produzindo excesso de sinalização e tempo desperdiçado — o mesmo código com critério explícito devolve só o achado real.", bloom: "Analisar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "prompt vago leva o modelo a adivinhar padrão em vez de aplicar regra, gerando falsos positivos", topicos: ["Critérios Explícitos"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", C: "extremo-vs-meio" } },
  { n: 10, correta: "B", resumo: "Um enum sem uma opção ambígua de escape obriga o modelo a \"mentir com precisão\", forçando a entrada real na categoria mais próxima mesmo quando nenhuma se encaixa — a correção é incluir a opção de escape, não remover o enum nem criar uma segunda tool.", bloom: "Analisar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "enum precisa de opção de escape ambígua; sem ela, o modelo força correspondência falsa", topicos: ["Tool Use Schema"], arquetipos: { A: "extremo-vs-meio", C: "over-engineering", D: "vazio-ausente" } },
  { n: 11, correta: "C", resumo: "`tool_choice: none` impede qualquer chamada de tool, garantindo texto puro para um consumidor a jusante que só sabe processar prosa.", bloom: "Lembrar", dificuldade: "Fácil", cenario: "S4 — Developer Productivity", principio: "`tool_choice: none` garante resposta em texto puro, sem chamada de tool", topicos: ["Tool Choice"], arquetipos: { A: "extremo-vs-meio", B: "camada-alvo-errado", D: "extremo-vs-meio" } },
  { n: 12, correta: "C", resumo: "A Message Batches API cobra 50% do preço padrão, garante acesso aos resultados quando tudo completa ou após 24 horas (o que vier primeiro), e a maioria dos batches termina em menos de uma hora.", bloom: "Lembrar", dificuldade: "Fácil", cenario: "S6 — Structured Data Extraction", principio: "batch processing custa metade do preço padrão, com janela de acesso de até 24h", topicos: ["Batch Processing"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 13, correta: "C", resumo: "Fronteiras explícitas de inclusão e exclusão impedem o modelo de gerar achados em categorias onde seu desempenho é conhecidamente pouco confiável — depender de confiança auto-reportada ou só reordenar por confiança não removem o ruído.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "fronteiras explícitas de inclusão/exclusão impedem achados em categorias de baixa confiabilidade conhecida", topicos: ["Critérios Explícitos"], arquetipos: { A: "sinal-nao-confiavel", B: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 14, correta: "A", resumo: "Schema não é validação completa — ferramentas como Pydantic ou Instructor devem validar tanto a entrada gerada pelo modelo quanto a saída, nas duas direções.", bloom: "Lembrar", dificuldade: "Fácil", cenario: "S6 — Structured Data Extraction", principio: "validação estruturada (ex.: Pydantic) precisa cobrir entrada e saída do modelo, não só uma direção", topicos: ["Validação e Retry"], arquetipos: { B: "vazio-ausente", C: "montante-jusante", D: "camada-alvo-errado" } },
  { n: 15, correta: "A", resumo: "Consistência entre formatos de documento variados vem da combinação de schemas com campos opcionais, instruções de normalização de formato e exemplos few-shot — regras de pós-processamento por fornecedor não escalam, e modelo maior com prompt vago mantém a inconsistência.", bloom: "Avaliar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "schema com campos opcionais + normalização + few-shot juntos dão consistência entre formatos variados", topicos: ["Tool Use Schema", "Few-Shot"], arquetipos: { B: "over-engineering", C: "probabilistico-vs-garantia", D: "enumerar-vs-generalizar" } },
  { n: 16, correta: "B", resumo: "Exemplos few-shot devem incluir casos bons e ruins — os exemplos negativos são o que ensina o modelo a não disparar em situações parecidas mas que não deveriam ser sinalizadas, sendo a alavanca direta contra falso positivo.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "exemplos negativos (few-shot) ensinam o que NÃO sinalizar, reduzindo falso positivo diretamente", topicos: ["Few-Shot", "Critérios Explícitos"], arquetipos: { A: "vazio-ausente", C: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 17, correta: "C", resumo: "Para datas ambíguas, um campo dedicado (`unclear=true`) permite ao modelo declarar explicitamente a ambiguidade em vez de escolher em silêncio — nota livre não é consumível por sistema, e confiança sobre o documento inteiro não localiza qual campo é ambíguo.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "campo dedicado de ambiguidade declara incerteza explicitamente, em vez de escolher silenciosamente", topicos: ["Tool Use Schema"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", D: "vazio-ausente" } },
  { n: 18, correta: "D", resumo: "Um chat com o usuário esperando é síncrono por definição, porque bloqueia o fluxo até a resposta — os envelopes de latência de um chat e de um batch são completamente diferentes, e nenhum preço menor compensa deixar o usuário esperando até 24h.", bloom: "Analisar", dificuldade: "Médio", cenario: "S1 — Customer Support Resolution Agent", principio: "se o usuário está esperando ativamente, o processamento precisa ser síncrono, não batch", topicos: ["Batch Processing"], arquetipos: { A: "camada-alvo-errado", B: "extremo-vs-meio", C: "camada-alvo-errado" } },
  { n: 19, correta: "C", resumo: "O benefício principal de passadas separadas com exemplos dedicados é evitar o trade-off de recall entre preocupações concorrentes — não é eliminar falso positivo por completo nem economizar tokens (custa mais, mas ganha qualidade).", bloom: "Lembrar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "passadas especializadas evitam trade-off de recall entre preocupações concorrentes, não reduzem custo", topicos: ["Revisão Multi-Instância"], arquetipos: { A: "vazio-ausente", B: "extremo-vs-meio", D: "camada-alvo-errado" } },
  { n: 20, correta: "C", resumo: "Dizer explicitamente o que não deve ser mudado é tão vinculante quanto dizer o que mudar, e é o que evita mudança colateral fora do escopo pretendido.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "delimitar o escopo inclui declarar explicitamente o que NÃO deve ser alterado", topicos: ["Critérios Explícitos"], arquetipos: { A: "camada-alvo-errado", B: "vazio-ausente", D: "camada-alvo-errado" } },
  { n: 21, correta: "D", resumo: "Quando um ingrediente realmente não tem medida (\"flour, sifted\"), representar a ausência com um valor nulo explícito é o comportamento desejado — o schema permitia null e o prompt definiu quando usá-lo; o modelo acertou, não falhou.", bloom: "Analisar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "representar ausência real com null explícito é sucesso, não falha de extração", topicos: ["Tool Use Schema"], arquetipos: { A: "vazio-ausente", B: "montante-jusante", C: "camada-alvo-errado" } },
  { n: 22, correta: "B", resumo: "Para normalizar telefone em qualquer formato de origem, a regra é remover todos os caracteres não numéricos e aplicar o formato E.164, com exemplos mostrando a transformação — regex no JSON Schema só valida, não reformata, e trigger de banco normaliza tarde demais.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "normalização de telefone é regra explícita (remover não-dígitos + E.164) com exemplos, não validação nem correção tardia", topicos: ["Tool Use Schema"], arquetipos: { A: "camada-alvo-errado", C: "vazio-ausente", D: "montante-jusante" } },
  { n: 23, correta: "A", resumo: "Um Message Batch é limitado a 100.000 requisições ou 256 MB de tamanho, o que for atingido primeiro — os dois limites valem juntos, não um no lugar do outro.", bloom: "Lembrar", dificuldade: "Fácil", cenario: "S6 — Structured Data Extraction", principio: "limite de um Message Batch é 100.000 requisições OU 256 MB, o que vier primeiro", topicos: ["Batch Processing"], arquetipos: { B: "camada-alvo-errado", C: "vazio-ausente", D: "feature-inexistente-verossimil" } },
  { n: 24, correta: "B", resumo: "Pedir para o modelo omitir um preâmbulo é enforcement por prompt e falha de vez em quando; a correção estrutural é a saída chegar como argumentos tipados de uma chamada de tool, não como prosa que alguém tenta interpretar — aí o preâmbulo deixa de ser possível.", bloom: "Analisar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "saída como argumentos tipados de tool elimina estruturalmente o preâmbulo, ao contrário de pedir por prompt", topicos: ["Tool Use Schema"], arquetipos: { A: "probabilistico-vs-garantia", C: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 25, correta: "C", resumo: "Dividir em escopo menor e mesclar depois é a recomendação certa contra truncamento — elevar o limite não escala para o próximo PR maior, e truncamento de saída estruturada não é degradação suave, é corrupção da estrutura.", bloom: "Avaliar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "escopo menor + merge escala contra truncamento; elevar limite ou usar markdown não resolvem de fato", topicos: ["Validação e Retry"], arquetipos: { A: "extremo-vs-meio", B: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 26, correta: "D", resumo: "Para que um script consiga agir sobre a saída de um revisor automatizado, ela precisa de campos exatos, valores permitidos e um mecanismo restrito por schema — \"detalhado e bem estruturado\" não define campo nenhum, e depender do modelo ser consistente em markdown é o pressuposto que falha.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S5 — Claude Code for CI", principio: "saída consumível por máquina exige campos exatos + valores permitidos + restrição por schema, não prosa \"bem organizada\"", topicos: ["Tool Use Schema", "CI/CD"], arquetipos: { A: "vazio-ausente", B: "vazio-ausente", C: "sinal-nao-confiavel" } },
  { n: 27, correta: "A", resumo: "Exemplos few-shot precisam incluir casos de borda, tanto bons quanto ruins — sem uma âncora para o caso difícil, o comportamento nesse caso fica livre e errático; temperatura mais alta só piora a variação.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S1 — Customer Support Resolution Agent", principio: "casos de borda precisam de exemplo próprio nos few-shot; sem eles o comportamento nesse caso é errático", topicos: ["Few-Shot"], arquetipos: { B: "extremo-vs-meio", C: "camada-alvo-errado", D: "enumerar-vs-generalizar" } },
  { n: 28, correta: "A", resumo: "A diferença entre tool use e pedir formato via prompt é de mecanismo — com tool use o modelo preenche um schema declarado; com prompt ele formata prosa e torce para caber, bem menos confiável para um pipeline tipado.", bloom: "Analisar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "tool use preenche schema declarado; prompt apenas formata prosa — mecanismos com confiabilidade bem diferente", topicos: ["Tool Use Schema"], arquetipos: { B: "camada-alvo-errado", C: "sinal-nao-confiavel", D: "camada-alvo-errado" } },
  { n: 29, correta: "D", resumo: "Um enum que não cobre a distribuição real dos valores força o modelo a mapear um caso mais grave numa categoria mais fraca (ex.: \"outage total\" virando \"high\"), perdendo a distinção que importava — texto livre destrói a padronização, e inferir por sentimento é sinal não confiável.", bloom: "Analisar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "enum incompleto força imprecisão na categoria escolhida, perdendo distinções reais", topicos: ["Tool Use Schema"], arquetipos: { A: "vazio-ausente", B: "extremo-vs-meio", C: "sinal-nao-confiavel" } },
  { n: 30, correta: "A", resumo: "Dados numéricos e de preço tendem a se perder em sumarizações sucessivas — a solução é extrair os dados-chave e reinjetá-los diretamente no próximo prompt, em vez de confiar que a sumarização os preserve.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "extrair e reinjetar dados numéricos evita que sumarização progressiva os perca", topicos: ["Contexto Longo"], arquetipos: { B: "camada-alvo-errado", C: "extremo-vs-meio", D: "probabilistico-vs-garantia" } },
  { n: 31, correta: "C", resumo: "\"Sinalize apenas quando a entrada vai direto para a query sem parametrização\" é o critério de inclusão; \"não sinalize ORM nem prepared statements\" é o de exclusão — os dois juntos formam o critério explícito completo.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "critério explícito completo tem cláusula de inclusão E de exclusão, não uma sozinha", topicos: ["Critérios Explícitos"], arquetipos: { A: "feature-inexistente-verossimil", B: "sinal-nao-confiavel", D: "vazio-ausente" } },
  { n: 32, correta: "B", resumo: "O critério de detecção (universal) deve ficar separado das convenções e padrões aceitos daquele repositório específico (local), fornecidos como contexto persistente próprio — inferir convenção a partir do próprio código sob suspeita é adivinhação.", bloom: "Analisar", dificuldade: "Difícil", cenario: "S4 — Developer Productivity", principio: "separar critério de detecção universal de convenções locais, fornecidas como contexto persistente por repositório", topicos: ["Critérios Explícitos", "Path Rules"], arquetipos: { A: "montante-jusante", C: "enumerar-vs-generalizar", D: "vazio-ausente" } },
  { n: 33, correta: "B", resumo: "Como nenhuma resposta por documento é necessária de imediato, mudar para processamento em batch corrige o bloqueio de worker e o custo ao mesmo tempo — paralelizar o loop síncrono ou trocar de modelo mantêm o desenho errado.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "batch corrige bloqueio de worker e custo simultaneamente, quando nada precisa de resposta imediata", topicos: ["Batch Processing"], arquetipos: { A: "camada-alvo-errado", C: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 34, correta: "D", resumo: "Um campo numérico nulo, acompanhado de um flag de status, representa a ausência com precisão e ainda diz o motivo — distinguindo \"a determinar\" de \"não mencionado\"; estimar é fabricar dado, e zero é um valor falso que contamina somas.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "null + campo de status distingue motivos de ausência sem inventar valor numérico", topicos: ["Tool Use Schema"], arquetipos: { A: "probabilistico-vs-garantia", B: "camada-alvo-errado", C: "vazio-ausente" } },
  { n: 35, correta: "D", resumo: "Um valor pode ser válido contra o schema (tipo, formato) e ainda estar semanticamente errado (ex.: total não bate com a soma das linhas) — schema não é validação completa; regra de negócio entre campos é responsabilidade da camada de aplicação.", bloom: "Analisar", dificuldade: "Difícil", cenario: "S6 — Structured Data Extraction", principio: "conformidade de schema não garante correção semântica entre campos — isso é validação de aplicação", topicos: ["Validação e Retry"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", C: "probabilistico-vs-garantia" } },
  { n: 36, correta: "D", resumo: "Uma descrição consolidada dos oito problemas, específica o bastante para orientar uma revisão única e coerente, evita que a correção de um problema quebre outro — requisições separadas ou perguntar \"o que você melhoraria\" devolvem o critério ao modelo que já errou.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "descrição consolidada e específica de todos os problemas permite correção coerente numa única passada", topicos: ["Refinamento Iterativo"], arquetipos: { A: "extremo-vs-meio", B: "sinal-nao-confiavel", C: "vazio-ausente" } },
  { n: 37, correta: "C", resumo: "\"Tom profissional\" é julgamento subjetivo que varia entre execuções — um critério concreto combinado com um exemplo aceitável é o par que estabiliza a saída; temperatura mais alta e comprimento não são a variável em jogo.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "critério concreto + exemplo aceitável estabilizam saída que depende de julgamento subjetivo vago", topicos: ["Refinamento Iterativo", "Few-Shot"], arquetipos: { A: "extremo-vs-meio", B: "camada-alvo-errado", D: "probabilistico-vs-garantia" } },
  { n: 38, correta: "A", resumo: "Roteamento para revisão humana deve combinar score de confiança, características do documento e ambiguidade em nível de campo — confiança sozinha é auto-relato do modelo, um sinal fraco isolado, mesmo sendo um sinal válido entre vários.", bloom: "Analisar", dificuldade: "Difícil", cenario: "S6 — Structured Data Extraction", principio: "confiança do modelo é um sinal entre vários para roteamento — nunca o critério único", topicos: ["Validação e Retry"], arquetipos: { B: "sinal-nao-confiavel", C: "feature-inexistente-verossimil", D: "camada-alvo-errado" } },
  { n: 39, correta: "D", resumo: "Quando o requisito é \"sempre extrair, nunca responder em texto\", o schema define a forma e `tool_choice` forçando aquela tool garante que a chamada aconteça e que não venha uma resposta conversacional — sem tool ou com `auto`/`none`, essa garantia não existe.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "requisito de \"sempre/nunca\" pede schema + `tool_choice` forçado, não apenas prompt ou `auto`", topicos: ["Tool Choice", "Tool Use Schema"], arquetipos: { A: "probabilistico-vs-garantia", B: "extremo-vs-meio", C: "probabilistico-vs-garantia" } },
  { n: 40, correta: "C", resumo: "Exemplos ancoram o modelo na preocupação específica que estão ensinando — misturar exemplos de preocupações diferentes num mesmo conjunto dilui essa âncora e reintroduz a competição entre preocupações que passadas separadas tentam evitar.", bloom: "Analisar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "exemplos de preocupações diferentes misturados diluem a âncora de cada um, reintroduzindo competição", topicos: ["Few-Shot", "Revisão Multi-Instância"], arquetipos: { A: "feature-inexistente-verossimil", B: "camada-alvo-errado", D: "feature-inexistente-verossimil" } },
  { n: 41, correta: "A", resumo: "Consistência entre formatos de documento difíceis vem de exemplos dos layouts problemáticos combinados com instruções de normalização das peculiaridades de cada um — recusar os documentos difíceis ou mandar tudo para revisão humana sem triagem desistem do escopo.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "exemplos dos layouts difíceis + normalização de suas peculiaridades dão consistência, sem descartar escopo", topicos: ["Few-Shot", "Tool Use Schema"], arquetipos: { B: "extremo-vs-meio", C: "camada-alvo-errado", D: "montante-jusante" } },
  { n: 42, correta: "D", resumo: "Fronteiras explícitas no prompt impedem o modelo de gerar achados em categorias onde seu desempenho é conhecidamente pouco confiável — diferente de truncamento, violação de schema ou rate limiting, que são outros problemas.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "fronteiras explícitas de escopo impedem achados em categorias de baixa confiabilidade — não é o mesmo mecanismo de truncamento/validação/rate-limit", topicos: ["Critérios Explícitos"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", C: "camada-alvo-errado" } },
  { n: 43, correta: "A", resumo: "Os resultados de um Message Batch são recuperáveis individualmente por requisição, e o acesso acontece quando tudo completa ou ao fim da janela de 24 horas, o que vier primeiro — não é preciso reenviar o batch inteiro por uma falha pontual.", bloom: "Lembrar", dificuldade: "Fácil", cenario: "S6 — Structured Data Extraction", principio: "resultados de batch são recuperáveis por requisição individual, acesso após conclusão ou 24h", topicos: ["Batch Processing"], arquetipos: { B: "camada-alvo-errado", C: "vazio-ausente", D: "camada-alvo-errado" } },
  { n: 44, correta: "B", resumo: "Ao mesclar estruturas resultantes de chamadas divididas, o merge precisa tratar colisões, duplicatas e preservar de qual arquivo veio cada achado — recusa de JSON, `tool_choice` por chamada e enum não são os riscos relevantes aqui.", bloom: "Analisar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "merge de estruturas divididas precisa tratar colisão/duplicata e preservar proveniência", topicos: ["Validação e Retry"], arquetipos: { A: "camada-alvo-errado", C: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 45, correta: "C", resumo: "Um schema estrito na tool é o mecanismo que impede um campo fora do contrato — mais exemplos só reduzem a frequência, apagar no parsing esconde que o modelo está fora do contrato, e pedir para não incluir é enforcement por prompt que funciona quase sempre.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "schema estrito impede estruturalmente campo fora do contrato; não é questão de mais exemplos ou instrução", topicos: ["Tool Use Schema"], arquetipos: { A: "extremo-vs-meio", B: "vazio-ausente", D: "probabilistico-vs-garantia" } },
  { n: 46, correta: "A", resumo: "Ir além do par entrada/saída e anotar cada exemplo com uma justificativa explicita o critério de decisão, tornando a fronteira transferível para casos novos que os exemplos não cobriram diretamente.", bloom: "Avaliar", dificuldade: "Difícil", cenario: "S4 — Developer Productivity", principio: "justificativa anotada nos exemplos few-shot torna a fronteira de decisão transferível a casos novos", topicos: ["Few-Shot"], arquetipos: { B: "camada-alvo-errado", C: "camada-alvo-errado", D: "vazio-ausente" } },
  { n: 47, correta: "D", resumo: "Diante de muito dado de uma vez, o modelo tende a usar bem as primeiras e últimas partes e ignorar o meio — a solução é verificar e processar em seções, com passadas dirigidas, em vez de confiar numa passada única sobre tudo.", bloom: "Analisar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "\"lost in the middle\" se mitiga processando em seções, não confiando numa passada única sobre volume grande", topicos: ["Contexto Longo"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", C: "camada-alvo-errado" } },
  { n: 48, correta: "D", resumo: "Nomear uma categoria como fora de escopo diretamente no prompt é o critério de exclusão explícito, o mecanismo previsto para isso — limiar de confiança usa sinal fraco, hook não molda conteúdo de revisão, e filtro por palavra-chave derruba achados legítimos junto.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "categoria nomeada como fora de escopo no prompt é o critério de exclusão explícito correto", topicos: ["Critérios Explícitos"], arquetipos: { A: "sinal-nao-confiavel", B: "camada-alvo-errado", C: "sinal-nao-confiavel" } },
  { n: 49, correta: "D", resumo: "Um campo de data nullable com null explícito permite ao consumidor distinguir \"documento não especificou\" de qualquer data real — string num campo tipado quebra o consumidor, data atual como default é um valor inventado, e omitir o registro descarta os outros campos extraídos com sucesso.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "campo nullable com null explícito distingue \"não especificado\" de qualquer valor real, sem inventar nem descartar o registro", topicos: ["Tool Use Schema"], arquetipos: { A: "camada-alvo-errado", B: "feature-inexistente-verossimil", C: "camada-alvo-errado" } },
  { n: 50, correta: "A", resumo: "\"Bom\" é julgamento subjetivo; \"três bullets, menos de 20 palavras, cobrindo decisão/responsável/prazo, sem contexto de fundo\" é verificável item a item, inclusive o que não incluir.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "critério verificável item a item (incluindo o que não incluir) substitui julgamento subjetivo como \"bom\"", topicos: ["Critérios Explícitos"], arquetipos: { B: "camada-alvo-errado", C: "vazio-ausente", D: "camada-alvo-errado" } },
  { n: 51, correta: "B", resumo: "Forçar a tool garante que ela seja chamada e a forma dos argumentos — mas uma regra entre campos (semântica) continua exigindo uma camada de validação e retry separada; a chamada em si não falhou, os argumentos é que violaram uma regra de negócio.", bloom: "Analisar", dificuldade: "Difícil", cenario: "S6 — Structured Data Extraction", principio: "`tool_choice` forçado garante chamada e forma; regra semântica entre campos ainda precisa de validação própria", topicos: ["Tool Choice", "Validação e Retry"], arquetipos: { A: "camada-alvo-errado", C: "camada-alvo-errado", D: "probabilistico-vs-garantia" } },
  { n: 52, correta: "A", resumo: "O merge é a parte frágil de dividir uma extração em chamadas: chaves compartilhadas, ordenação e o caso de uma das chamadas voltar vazia precisam de regra definida — temperatura, mesmo batch ou `max_tokens` igual não resolvem isso.", bloom: "Analisar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "merge de chamadas divididas precisa de regra explícita para chaves compartilhadas, ordem e chamada vazia", topicos: ["Validação e Retry"], arquetipos: { B: "camada-alvo-errado", C: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 53, correta: "A", resumo: "Normalizar país segue a mesma família de regras de normalização — declarar a representação alvo e mapear as variantes observadas com exemplos, em vez de deduplicar depois (perde o contexto do documento) ou empurrar a normalização para cada consumidor.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "normalização de país é regra + mapeamento de variantes com exemplos, mesma família das outras normalizações", topicos: ["Tool Use Schema"], arquetipos: { B: "montante-jusante", C: "camada-alvo-errado", D: "vazio-ausente" } },
  { n: 54, correta: "A", resumo: "Mesmo com instruções claras, uma única passada com várias preocupações sofre de duas causas somadas — competição por atenção entre as preocupações e diluição dos exemplos, que servem bem a uma delas e atrapalham as outras.", bloom: "Analisar", dificuldade: "Difícil", cenario: "S4 — Developer Productivity", principio: "uma passada com múltiplas preocupações sofre de competição por atenção E diluição de exemplos, não de uma causa só", topicos: ["Revisão Multi-Instância", "Few-Shot"], arquetipos: { B: "feature-inexistente-verossimil", C: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 55, correta: "C", resumo: "Confiança auto-reportada é o sinal mais fraco isoladamente entre os citados, porque é o modelo avaliando a si mesmo — layout fora do template, falha em validação cruzada e campo obrigatório vindo null são fatos verificáveis e objetivos.", bloom: "Analisar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "confiança auto-reportada é o sinal mais fraco isoladamente, comparado a fatos verificáveis sobre documento/extração", topicos: ["Validação e Retry"], arquetipos: { A: "camada-alvo-errado", B: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 56, correta: "B", resumo: "`enum` é o elemento do JSON Schema que fecha o conjunto de valores permitidos, reduzindo ambiguidade — `type: string` aceita qualquer string, `required` só obriga presença, e descrição orienta sem restringir formalmente.", bloom: "Lembrar", dificuldade: "Fácil", cenario: "S6 — Structured Data Extraction", principio: "`enum` é o único elemento do schema que fecha o conjunto de valores permitidos", topicos: ["Tool Use Schema"], arquetipos: { A: "camada-alvo-errado", C: "camada-alvo-errado", D: "camada-alvo-errado" } },
  { n: 57, correta: "B", resumo: "Validar contra as regras de negócio antes da escrita, com um caminho de revisão ou retry para as falhas, evita descobrir o erro só no momento da inserção no banco — afrouxar constraint ou inserir uma a uma não previnem nem tratam o problema de fato.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "validação de regra de negócio antes da escrita (com retry/revisão) evita descoberta tardia no insert", topicos: ["Validação e Retry"], arquetipos: { A: "camada-alvo-errado", C: "vazio-ausente", D: "camada-alvo-errado" } },
  { n: 58, correta: "B", resumo: "Exemplos do que parece um problema mas na verdade não é são a alavanca direta contra falso positivo — ancoram os dois lados da fronteira de decisão, não só o lado do que deve ser sinalizado.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S4 — Developer Productivity", principio: "exemplos do tipo \"parece problema mas não é\" ancoram a fronteira contra falso positivo", topicos: ["Few-Shot", "Critérios Explícitos"], arquetipos: { A: "camada-alvo-errado", C: "vazio-ausente", D: "camada-alvo-errado" } },
  { n: 59, correta: "A", resumo: "Um container estruturado com um array vazio torna \"nada encontrado\" um resultado explícito e consumível, distinto de \"não houve resposta nenhuma\" — um achado fantasma com severidade \"none\" polui a tabela, e ausência de chamada de tool é indistinguível de falha.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "array vazio num container estruturado é resultado válido e explícito de \"nada encontrado\", diferente de ausência de resposta", topicos: ["Tool Use Schema"], arquetipos: { B: "vazio-ausente", C: "vazio-ausente", D: "camada-alvo-errado" } },
  { n: 60, correta: "D", resumo: "O critério que decide por batch é bloqueio e janela aceitável — ninguém espera resposta individual, e a janela de processamento cabe dentro do período disponível (ex.: entre meia-noite e 8h); os custos entre batch e síncrono não são iguais, e ter prazo não implica precisar de resposta síncrona.", bloom: "Aplicar", dificuldade: "Médio", cenario: "S6 — Structured Data Extraction", principio: "batch se justifica por ninguém esperar resposta individual E a janela de tempo caber no processamento", topicos: ["Batch Processing"], arquetipos: { A: "extremo-vs-meio", B: "camada-alvo-errado", C: "camada-alvo-errado" } },
];

